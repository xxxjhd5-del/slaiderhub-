local secondsAFK = 0
task.spawn(function()
	while true do
		task.wait(1)
		secondsAFK = secondsAFK + 1
		local hrs = math.floor(secondsAFK / 3600)
		local mins = math.floor((secondsAFK % 3600) / 60)
		local secs = secondsAFK % 60
		timerLabel.Text = string.format("وقت الـ AFK: %02d:%02d:%02d", hrs, mins, secs)
	end
end)

