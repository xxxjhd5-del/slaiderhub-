local function setImage(label, id)
    label.Image = "rbxthumb://type=Asset&id=" .. id .. "&w=420&h=420"
    task.spawn(function()
        task.wait(2.5)
        if not label.IsLoaded then
            label.Image = "rbxassetid://" .. id
        end
    end)
end

local function click()
    if CLICK_ID == "0" then return end
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://" .. CLICK_ID
        s.Volume = 1
        s.PlaybackSpeed = 0.95 + math.random() * 0.15
        s.Parent = sound_
        s:Play()
        debris_:AddItem(s, 2)
    end)
end

