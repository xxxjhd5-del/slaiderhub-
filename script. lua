local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Exclude

local function bombOf(char)
    if not char then return end
    for _, t in pairs(char:GetChildren()) do
        if t:IsA("Tool") and t.Name:lower():find("bomb") then
            return t
        end
    end
end

local function broad(char, plr)
    for _, v in ipairs(char:GetDescendants()) do
        if v.Name:lower():find("bomb") then
            return true
        end
    end
    for k, v in pairs(char:GetAttributes()) do
        if tostring(k):lower():find("bomb") and v then
            return true
        end
    end
    if plr then
        for k, v in pairs(plr:GetAttributes()) do
            if tostring(k):lower():find("bomb") and v then
                return true
            end
        end
    end
    return false
end

local function holder()
    for _, p in pairs(plrs:GetPlayers()) do
        local c = p.Character
        if c and bombOf(c) then
            return p, c
        end
    end
    for _, p in pairs(plrs:GetPlayers()) do
        local c = p.Character
        if c and broad(c, p) then
            return p, c
        end
    end
end

local function closest()
    local c = me.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if not r then return end
    local best, bd = nil, 9e9
    for _, p in pairs(plrs:GetPlayers()) do
        local pc = p ~= me and p.Character
        local hr = pc and pc:FindFirstChild("HumanoidRootPart")
        local hm = pc and pc:FindFirstChildOfClass("Humanoid")
        if hr and hm and hm.Health > 0 then
            local d = (hr.Position - r.Position).Magnitude
            if d < bd then best, bd = hr, d end
        end
    end
    return best, bd
end

local function fleePoint(root, from)
    local away = (root.Position - from) * Vector3.new(1, 0, 1)
    if away.Magnitude < 0.1 then
        away = root.CFrame.LookVector
    end
    away = away.Unit
    local best, bs = nil, -9e9
    for a = -150, 150, 30 do
        local dir = CFrame.fromAxisAngle(Vector3.new(0, 1, 0), math.rad(a)):VectorToWorldSpace(away)
        local hit = workspace:Raycast(root.Position, dir * 14, rp)
        local clear = hit and (hit.Position - root.Position).Magnitude or 14
        if clear > 5 then
            local pt = root.Position + dir * 14
            local ground = workspace:Raycast(pt + Vector3.new(0, 3, 0), Vector3.new(0, -30, 0), rp)
            if ground then
                local score = dir:Dot(away) * 10 + clear * 0.3
                if score > bs then
                    best, bs = ground.Position, score
                end
            end
        end
    end
    return best
end

task.spawn(function()
    while task.wait(0.1) do
        local char = me.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if hum and root then
            rp.FilterDescendantsInstances = {char}
            local hp, hc = holder()
            if hp then
                status.Text = "Bomb: " .. (hp == me and "YOU" or hp.DisplayName)
            else
                status.Text = "Bomb: none"
            end

            if hp == me then
                if walkOn then
                    local tgt, d = closest()
                    if tgt then
                        hum:MoveTo(tgt.Position)
                        local tool = bombOf(char)
                        if tool and d < 6 then
                            pcall(function() tool:Activate() end)
                        end
                    end
                end
            elseif escOn and hp and hc then
                local hrp = hc:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d = (hrp.Position - root.Position).Magnitude
                    if d < ESC_DIST then
                        local pt = fleePoint(root, hrp.Position)
                        if not pt then
                            local away = (root.Position - hrp.Position) * Vector3.new(1, 0, 1)
                            if away.Magnitude < 0.1 then
                                away = root.CFrame.LookVector
                            end
                            pt = root.Position + away.Unit * 14
                        end
                        hum:MoveTo(pt)
                    end
                end
            end
        end
    end
end)
